[{"sha":"16c306d53d27fe102a1a54bbd0e57eb36900655d","node_id":"C_kwDOACN7MtoAKDE2YzMwNmQ1M2QyN2ZlMTAyYTFhNTRiYmQwZTU3ZWIzNjkwMDY1NWQ","commit":{"author":{"name":"Zhigang Luo","email":"Zhigang.Luo@amd.com","date":"2026-08-31T19:30:35Z"},"committer":{"name":"Alex Deucher","email":"alexander.deucher@amd.com","date":"2026-10-07T16:02:29Z"},"message":"drm/amdgpu: fetch the A+A VF VBIOS from the SRAT HBM range\n\nOn A+A the VF has no usable FB BAR, so the VBIOS copy cannot be read\nthrough BAR 0. It lives in HBM, which the SRAT describes as\nspecific-purpose memory reachable at a system physical address.\n\nAdd a dedicated amdgpu_read_bios_from_spm() path that resolves the HBM\nrange from SRAT and maps it as write-back system memory. Keep the\nexisting SR-IOV dynamic critical region path when it is enabled,\nmatching the VRAM reader.\n\nv2:\n- Use a separate amdgpu_read_bios_from_spm() helper and leave\n  amdgpu_read_bios_from_vram() unchanged.\n- Keep the SR-IOV dynamic critical region path for SPM-backed VBIOS.\n- Fetch VBIOS after the COMMON block and make it optional for\n  SPM-backed SR-IOV VF and passthrough configurations.\n\nv3:\n- Keep the SRAT range local to the VBIOS path; GMC owns aper_base and\n  aper_size.\n- Map SPM with memremap(), memcpy(), and memunmap().\n- Rely on amdgpu_virt_vram_is_spm() without redundant VF/passthrough\n  checks.\n\nSigned-off-by: Zhigang Luo <zhigang.luo@amd.com>\nSigned-off-by: Fangsheng Huang <Fangsheng.Huang@amd.com>\nSigned-off-by: YuBiao Wang <YuBiao.Wang@amd.com>\nReviewed-by: Lijo Lazar <lijo.lazar@amd.com>\nSigned-off-by: Alex Deucher <alexander.deucher@amd.com>","tree":{"sha":"67425ef29e6f53ef4b3bf9d0045f28e8ba162cd0","url":"https://api.github.com/repos/torvalds/linux/git/trees/67425ef29e6f53ef4b3bf9d0045f28e8ba162cd0"},"url":"https://api.github.com/repos/torvalds/linux/git/commits/16c306d53d27fe102a1a54bbd0e57eb36900655d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/torvalds/linux/commits/16c306d53d27fe102a1a54bbd0e57eb36900655d","html_url":"https://github.com/torvalds/linux/commit/16c306d53d27fe102a1a54bbd0e57eb36900655d","comments_url":"https://api.github.com/repos/torvalds/linux/commits/16c306d53d27fe102a1a54bbd0e57eb36900655d/comments","author":{"login":"amd-zhluo","id":281765585,"node_id":"U_kgDOEMtm0Q","avatar_url":"https://avatars.githubusercontent.com/u/281765585?v=4","gravatar_id":"","url":"https://api.github.com/users/amd-zhluo","html_url":"https://github.com/amd-zhluo","followers_url":"https://api.github.com/users/amd-zhluo/followers","following_url":"https://api.github.com/users/amd-zhluo/following{/other_user}","gists_url":"https://api.github.com/users/amd-zhluo/gists{/gist_id}","starred_url":"https://api.github.com/users/amd-zhluo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/amd-zhluo/subscriptions","organizations_url":"https://api.github.com/users/amd-zhluo/orgs","repos_url":"https://api.github.com/users/amd-zhluo/repos","events_url":"https://api.github.com/users/amd-zhluo/events{/privacy}","received_events_url":"https://api.github.com/users/amd-zhluo/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"alexdeucher","id":118310711,"node_id":"U_kgDOBw1HNw","avatar_url":"https://avatars.githubusercontent.com/u/118310711?v=4","gravatar_id":"","url":"https://api.github.com/users/alexdeucher","html_url":"https://github.com/alexdeucher","followers_url":"https://api.github.com/users/alexdeucher/followers","following_url":"https://api.github.com/users/alexdeucher/following{/other_user}","gists_url":"https://api.github.com/users/alexdeucher/gists{/gist_id}","starred_url":"https://api.github.com/users/alexdeucher/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alexdeucher/subscriptions","organizations_url":"https://api.github.com/users/alexdeucher/orgs","repos_url":"